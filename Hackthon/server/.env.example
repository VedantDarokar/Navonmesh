PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/navonmesh?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Firebase Cloud Messaging (for closed-app mobile heads-up push notifications)
# Option 1: File name in server root (for local development)
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json

# Option 2: Full JSON string (ideal for cloud hosting like Render / Railway / Heroku)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"navonmesh-e0818",...}

# Option 3: Legacy Server Key (if enabled in Firebase Console)
# FCM_SERVER_KEY=AAAA...
